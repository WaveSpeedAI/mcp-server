{
  "name": "@wavespeed/mcp",
  "version": "1.3.0",
  "description": "WaveSpeed MCP server — run any model on the live WaveSpeed catalog (image, video, audio, 3D) with schema introspection, local-file upload, and price quotes.",
  "type": "module",
  "bin": {
    "wavespeed-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveSpeedAI/mcp-server.git"
  },
  "homepage": "https://wavespeed.ai",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wavespeed",
    "ai-image-generation",
    "ai-video-generation",
    "mcp-server"
  ],
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "wavespeed": "^0.3.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "mcpName": "ai.wavespeed/mcp"
}
